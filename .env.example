# AstroMath Environment Variables

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret
JWT_SECRET=astromath_super_secret_jwt_key_2026_cosmic_secure
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Email SMTP (for OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=no-reply@astromath.ai

# Database
DATABASE_URL=sqlite:///./astromath.db

# Server
PORT=8000
HOST=0.0.0.0
